rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Must match ADMIN_EMAILS in src/lib/config.ts
    function isAdmin() {
      return request.auth != null &&
             request.auth.token.email_verified == true &&
             request.auth.token.email == 'naim.bro@gmail.com';
    }

    function isApprovedProfessor() {
      return request.auth != null && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/professors/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/professors/$(request.auth.uid)).data.status == 'approved')
      );
    }

    function ownsCourse(courseId) {
      let course = get(/databases/$(database)/documents/courses/$(courseId)).data;
      return request.auth != null && request.auth.uid == course.professorId;
    }

    // Professor access requests + profiles
    match /professors/{uid} {
      // A user may create ONLY their own request, and only as 'pending'
      allow create: if isOwner(uid) &&
                    request.resource.data.status == 'pending' &&
                    request.resource.data.uid == uid;
      // Owner sees their own doc; admin sees (and lists) all
      allow read: if isOwner(uid) || isAdmin();
      // Only the admin changes status
      allow update, delete: if isAdmin();
    }

    // Per-professor display preferences (today: the manual order of the course
    // cards on the dashboard). Deliberately NOT a field on professors/{uid}:
    // that document carries the access status and only the admin may write it.
    // Letting each user write their own would let them approve themselves.
    // Nothing here is security-relevant, so the owner reads and writes freely.
    match /professorPrefs/{uid} {
      allow read, write: if isOwner(uid);
    }

    // Courses collection (dynamic, professor-authored)
    match /courses/{courseId} {
      allow read: if isAuthenticated();
      allow create: if isApprovedProfessor() &&
                    request.resource.data.professorId == request.auth.uid;
      allow update, delete: if isAdmin() || ownsCourse(courseId);

      match /sessions/{sessionId} {
        allow read: if isAuthenticated();
        allow write: if isAdmin() || ownsCourse(courseId);
      }

      match /analytics/{docId} {
        allow read: if isAdmin() || ownsCourse(courseId);
        allow write: if false; // Only Cloud Functions write
      }
    }

    // Students collection - cross-course student profiles
    match /students/{studentId} {
      allow read, write: if isOwner(studentId);

      match /courseData/{courseId} {
        allow read: if isOwner(studentId) || ownsCourse(courseId);
        allow write: if false; // Only Cloud Functions write
      }
    }

    // Games collection
    match /games/{gameCode} {
      allow read: if isAuthenticated();

      // Creating games consumes OpenAI budget downstream -> approved professors only
      allow create: if isApprovedProfessor();

      // Students join/submit by updating the game doc
      allow update: if isAuthenticated();

      allow delete: if isAdmin() || (isAuthenticated() && resource.data.hostId == request.auth.uid);

      match /players/{playerId} {
        allow read: if isAuthenticated();
        allow write: if isOwner(playerId);
      }

      match /submissions/{submissionId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && request.resource.data.playerId == request.auth.uid;
        allow update: if false; // Only Cloud Functions write evaluations
      }

      // "Ya conteste la pregunta N" — un doc por jugador y pregunta, escrito en
      // el momento del click. Existe SOLO para que el host pueda cortar la
      // pregunta cuando ya respondieron todos: las submissions no sirven para eso
      // porque se escriben recien cuando el reloj llega a 'done'. Sin puntaje ni
      // respuesta adentro; el dato real sigue viajando en /submissions.
      match /answers/{answerId} {
        allow read: if isAuthenticated();
        allow create, update: if isAuthenticated()
          && request.resource.data.playerId == request.auth.uid;
        allow delete: if false;
      }

      // "Y elegi la C" — la otra mitad, separada de /answers justamente por
      // esto: la LEE SOLO EL ANFITRION. Publicada como /answers, cualquier
      // alumno con la consola abierta podria mirar lo que marcaron sus
      // companeros mientras la pregunta todavia corre, que es la respuesta
      // correcta servida en bandeja.
      //
      // El anfitrion la agrega y publica el RECUENTO en el doc del juego
      // (`mcStats`) cuando la pregunta cierra — o sea cuando la respuesta
      // correcta ya es publica y no queda nada que proteger. Eso es lo que
      // dibuja el grafico de aciertos, y por eso el grafico no necesita que
      // nadie mas pueda leer esta subcoleccion.
      match /choices/{choiceId} {
        allow read: if isAuthenticated()
          && get(/databases/$(database)/documents/games/$(gameCode)).data.hostId == request.auth.uid;
        allow create, update: if isAuthenticated()
          && request.resource.data.playerId == request.auth.uid;
        allow delete: if false;
      }

      // Feedback del juego: una nota de 1 a 7 y un comentario, uno por alumno.
      // Lo leen su dueno y el anfitrion de ESE juego; ningun alumno puede leer el
      // de otro, y ningun profesor puede leer el de una partida ajena.
      //
      // El anfitrion lo ve en el reporte de clase (/professor/report/:gameCode),
      // una pagina a la que entra a proposito despues de la clase, y NUNCA en la
      // pantalla final, que es la que se proyecta al curso: verlo ahi, con
      // nombre y delante de todos, cambia lo que la gente se atreve a escribir.
      //
      // NO es anonimo y en ninguna pantalla se dice que lo sea: el id del
      // documento es el uid de quien escribe.
      match /feedback/{playerId} {
        allow read: if isOwner(playerId) ||
                    (isAuthenticated() &&
                     get(/databases/$(database)/documents/games/$(gameCode)).data.hostId == request.auth.uid);
        allow create, update: if isOwner(playerId);
        allow delete: if false;
      }

      // Como se escribio cada respuesta abierta: tiempo a la primera tecla,
      // pegados, salidas de la app y la huella del texto.
      //
      // Registro privado del anfitrion. NO puntua, NO penaliza y NO se le
      // muestra a ningun alumno — ni siquiera la suya: leerla ensena
      // exactamente que hay que enganar.
      //
      // El id del doc es {uid}_{ronda}, y eso hace el trabajo pesado: un alumno
      // no puede escribir el registro de otro sin que el id lo delate, y no
      // puede reescribir el suyo (crear falla si ya existe, y update esta
      // cerrado). Lo que NINGUNA regla puede impedir es que mande numeros
      // inventados: los produce su propio navegador. Esto mide a la mayoria
      // honesta, no atrapa a quien se lo propone.
      //
      // `matches` en vez de armar el id con string(...data.round): el cast de
      // un numero en las reglas devuelve "3.0" si viajo como double, y la
      // comparacion fallaria en silencio. Los uid de Firebase son
      // alfanumericos, asi que no hay nada que escapar en la expresion.
      match /telemetria/{telemetriaId} {
        allow read: if isAuthenticated() &&
                    get(/databases/$(database)/documents/games/$(gameCode)).data.hostId == request.auth.uid;
        allow create: if isAuthenticated()
                      && request.resource.data.playerId == request.auth.uid
                      && telemetriaId.matches(request.auth.uid + '_[0-9]+');
        allow update, delete: if false;
      }

      match /rounds/{roundId} {
        allow read: if isAuthenticated();
        allow write: if false; // Only Cloud Functions write

        // Streamed recalibration duels (read by useRoundDuels for the live reveal)
        match /duels/{duelId} {
          allow read: if isAuthenticated();
          allow write: if false; // Only Cloud Functions write
        }
      }
    }

    // ---------------------------------------------------------------------
    // Compas: el instrumento de posicionamiento. No es un juego y no vive en
    // /games — ver content/compas/README.md.
    // ---------------------------------------------------------------------
    match /compasRuns/{code} {
      allow read: if isAuthenticated();
      allow create: if isApprovedProfessor();
      // Los alumnos se inscriben y actualizan su contador en el doc del run.
      allow update: if isAuthenticated();
      allow delete: if isAdmin()
        || (isAuthenticated() && resource.data.hostId == request.auth.uid);

      // Lo que respondio cada alumno. LO LEE SOLO EL ANFITRION, y por la misma
      // razon que /games/{code}/choices: un alumno que puede ver en vivo lo que
      // marcan sus companeros es un alumno que responde lo que responde la sala.
      // Ahi eso arruinaba una pregunta; aca arruina la medicion del semestre
      // entero, y sin dejar rastro — el instrumento sigue entregando numeros.
      //
      // El alumno lee y escribe el suyo, que es lo que le permite recargar el
      // telefono a mitad de camino sin perder lo que ya dijo.
      match /respuestas/{playerId} {
        allow read: if isOwner(playerId)
          || (isAuthenticated()
              && get(/databases/$(database)/documents/compasRuns/$(code)).data.hostId == request.auth.uid);
        allow create, update: if isOwner(playerId)
          && request.resource.data.playerId == request.auth.uid;
        allow delete: if false;
      }
    }

    // La posicion final, guardada por curso y por aplicacion — NO por run. Es lo
    // que hace comparable la Semana 3 con la Semana 15, que son dos runs con
    // codigos distintos separados por tres meses.
    //
    // Lectura abierta a autenticados a proposito: el mapa del curso se proyecta
    // y no hay nada privado adentro salvo el playerId. Nadie puede reescribir la
    // posicion de otro, que es lo unico que importa proteger aca.
    match /compas/{courseId}/{aplicacion}/{playerId} {
      allow read: if isAuthenticated();

      // Dos vias de escritura:
      //  - el alumno escribe la suya;
      //  - el ANFITRION del run escribe la de cualquiera de su sala, al cerrar.
      //
      // La segunda existe porque la primera sola perdia gente: quien cerraba la
      // pestana antes de que el profesor cerrara la sala no guardaba nunca su
      // posicion, y la comparacion de fin de semestre salia con huecos en
      // silencio. El anfitrion solo puede escribir bajo el id que dice el
      // payload y solo si es host del run que el mismo payload declara.
      allow create, update: if
        (isOwner(playerId) && request.resource.data.playerId == request.auth.uid)
        || (isAuthenticated()
            && request.resource.data.playerId == playerId
            && get(/databases/$(database)/documents/compasRuns/$(request.resource.data.runCode)).data.hostId == request.auth.uid);

      allow delete: if isAdmin();
    }

    // Tabla acumulada del curso. Contiene SOLO los diez primeros: el fondo de la
    // tabla no se guarda en ningun documento legible por otro alumno.
    match /standings/{courseId} {
      allow read: if isAuthenticated();
      allow write: if false; // Solo Cloud Functions
    }

    // Judges configuration (read-only for frontend)
    match /judges/{judgeId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Seeded judge baseline (personas) — readable by any authenticated professor so the
    // course-judges editor can show current personas. Written only by the seed (admin SDK).
    match /config/{docId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Per-course judge persona overrides (name/avatar/personality/evaluationStyle).
    // Course-wide by design: any approved professor may edit a course's judges.
    match /judgeOverrides/{courseId} {
      allow read: if isAuthenticated();
      allow write: if isApprovedProfessor();
    }
  }
}
