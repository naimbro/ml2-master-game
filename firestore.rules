rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isProfessor(courseId) {
      let course = get(/databases/$(database)/documents/courses/$(courseId)).data;
      return request.auth != null && request.auth.uid == course.professorId;
    }

    function isEnrolledInCourse(courseId) {
      let course = get(/databases/$(database)/documents/courses/$(courseId)).data;
      return request.auth != null &&
             (request.auth.token.email in course.enrolledEmails ||
              request.auth.uid == course.professorId);
    }

    // Courses collection
    match /courses/{courseId} {
      // Anyone authenticated can read course info
      allow read: if isAuthenticated();
      // Only professor can write
      allow write: if isProfessor(courseId);

      // Course subcollections
      match /sessions/{sessionId} {
        allow read: if isEnrolledInCourse(courseId);
        allow write: if isProfessor(courseId);
      }

      match /analytics/{docId} {
        allow read: if isProfessor(courseId);
        allow write: if false; // Only Cloud Functions write
      }
    }

    // Students collection - cross-course student profiles
    match /students/{studentId} {
      // Users can read/write their own profile
      allow read, write: if isOwner(studentId);

      // Course-specific data
      match /courseData/{courseId} {
        allow read: if isOwner(studentId) || isProfessor(courseId);
        allow write: if false; // Only Cloud Functions write
      }
    }

    // Games collection
    match /games/{gameCode} {
      // Anyone authenticated can read game state
      allow read: if isAuthenticated();

      // Creating games - must be enrolled (professor creates)
      allow create: if isAuthenticated();

      // Updating games - authenticated users can update (for joining/submitting)
      allow update: if isAuthenticated();

      // Delete - only professor
      allow delete: if isAuthenticated();

      // Players subcollection
      match /players/{playerId} {
        allow read: if isAuthenticated();
        allow write: if isOwner(playerId);
      }

      // Submissions subcollection
      match /submissions/{submissionId} {
        allow read: if isAuthenticated();
        // Players can create their own submissions
        allow create: if isAuthenticated() && request.resource.data.playerId == request.auth.uid;
        // Only Cloud Functions can update (for evaluation results)
        allow update: if false;
      }

      // Round results
      match /rounds/{roundId} {
        allow read: if isAuthenticated();
        allow write: if false; // Only Cloud Functions write
      }
    }

    // Judges configuration (read-only for frontend)
    match /judges/{judgeId} {
      allow read: if isAuthenticated();
      allow write: if false; // Admin only
    }
  }
}
